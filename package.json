{
  "name": "koku-ui",
  "version": "0.0.1",
  "description": "Cost Management UI monorepo",
  "repository": "https://github.com/project-koku/koku-ui.git",
  "author": "Red Hat",
  "license": "GNU AGPLv3",
  "private": true,
  "engines": {
    "node": ">=20.15.0",
    "npm": ">=10.8.0"
  },
  "packageManager": "npm@10.8.0",
  "workspaces": [
    "apps/saas",
    "apps/standalone"
  ],
  "scripts": {
    "clean": "npm run clean -w @koku-ui/saas && npm run clean -w @koku-ui/standalone --if-present",
    "dev": "npm run dev:saas",
    "dev:saas": "npm run start -w @koku-ui/saas",
    "dev:standalone": "npm run dev -w @koku-ui/standalone",
    "build": "npm run build -w @koku-ui/saas",
    "build:saas": "npm run build -w @koku-ui/saas",
    "build:standalone": "npm run build -w @koku-ui/standalone",
    "lint": "npm run lint -w @koku-ui/saas",
    "test": "npm run test -w @koku-ui/saas",
    "translations": "npm run translations -w @koku-ui/saas",
    "verify": "npm run verify -w @koku-ui/saas"
  }
}
